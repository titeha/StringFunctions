<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Ti-Soft.StringFunctions</PackageId>
    <BaseOutputPath>..\bin\StringFunctions</BaseOutputPath>
    <Version>2.1.0</Version>
    <Copyright>Artemy Sobolev</Copyright>
    <RepositoryUrl>https://github.com/titeha/StringFunctions</RepositoryUrl>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TieredPGO>true</TieredPGO>
    <EnableSIMD>true</EnableSIMD>
    <Description>Библиотека функций для работы со строками: проверка баланса скобок, нормализация строки, парсинг и форматирование диапазонов целых чисел, согласование существительных с числом и перевод чисел в слова (прописью) на русском языке.</Description>
    <PackageTags>strings;text;normalization;braces;ranges;parser;formatter;russian;pluralization;plural;number-to-words;numbertowords</PackageTags>
    <PackageProjectUrl>https://github.com/titeha/StringFunctions</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Company>Ti-Soft</Company>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName)Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ti-Soft.Results" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>
</Project>
